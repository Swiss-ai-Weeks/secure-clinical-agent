# Copy to .env and fill locally. Do not commit .env.

UID=1000
GID=1000

# Required to pull and start NVIDIA NIMs. Export it; do not paste it into chat.
NGC_API_KEY=

# Optional. Needed if google/medgemma-1.5-4b-it is gated on Hugging Face.
HF_TOKEN=

# Postgres `fhir` database (127.0.0.1:5432): schemas clinical, identity, audit.
# PATIENT360_FHIR_PASSWORD is the superuser owner (initdb and operators only).
# Services connect as the least-privilege roles; the init scripts set these
# passwords once, on an empty volume.
PATIENT360_FHIR_PASSWORD=change-me-fhir
# p360_app: FastAPI backend (reads clinical, owns sessions, writes audit)
PATIENT360_APP_PASSWORD=change-me-app
# p360_worker: ingestion worker (upserts clinical, seeds users, writes audit)
PATIENT360_WORKER_PASSWORD=change-me-worker
# p360_auditor: read-only on the audit schema
PATIENT360_AUDITOR_PASSWORD=change-me-auditor

# OpenFGA grants (127.0.0.1:8091). The preshared API key is held by the backend, the
# ingestion worker, and openfga-init; it has no scopes, so read/write separation is a
# property of which code paths call Write. The model and demo tuples are in
# stores/openfga/; `fga model test --tests stores/openfga/store.fga.yaml` runs offline.
PATIENT360_OPENFGA_KEY=change-me-openfga
# Datastore role `openfga` in the shared Postgres instance, own database `openfga`.
# Set once on an empty volume by 98-openfga-datastore.sh.
PATIENT360_OPENFGA_DB_PASSWORD=change-me-openfga-db

# immudb (127.0.0.1:3322) is retired behind `--profile legacy`; audit rows live in
# Postgres schema `audit`. Only needed if that profile is started.
PATIENT360_AUDIT_PASSWORD=change-me-audit

# Qdrant note-chunk vectors (127.0.0.1:6333).
PATIENT360_QDRANT_API_KEY=change-me-qdrant

# OpenBao linkage vault (127.0.0.1:8200). Dev listener for this lab; not Shamir-sealed,
# in-memory: re-run seed_demo.py after a restart. PATIENT360_LINKAGE_TOKEN is the root
# token, held only by openbao and openbao-init. The two tokens below are created by
# openbao-init with fixed ids (no '.' allowed): the backend one reads linkage/self/* and
# linkage/identity/*; the worker one writes linkage/* (seed_demo.py, ingestion worker).
# Generate each: openssl rand -hex 24
PATIENT360_LINKAGE_TOKEN=change-me-linkage-root
PATIENT360_LINKAGE_BACKEND_TOKEN=change-me-linkage-backend
PATIENT360_LINKAGE_WORKER_TOKEN=change-me-linkage-worker

# Backend (127.0.0.1:8080). HS256 secret for run tokens (RFC 9068 at+JWT, 10 min);
# the backend is the only issuer and verifier. Generate: openssl rand -hex 32
PATIENT360_RUN_TOKEN_SECRET=change-me-run-token
# true enables /docs and POST /dev/run-token. Never true outside the lab.
PATIENT360_DEV=true
# Break-glass window (minutes) written as the emergency tuple's active_window.
PATIENT360_BREAK_GLASS_MINUTES=60
# Minors. A guardian or named caregiver of a patient aged ADOLESCENT..MAJORITY-1 sees
# restricted (R) and very restricted (V) rows redacted: confidential adolescent care.
# Capacity of judgement (ZGB Art. 16) is not a fixed age; 14 is the lab default.
PATIENT360_ADOLESCENT_AGE=14
PATIENT360_MAJORITY_AGE=18
# Researcher aggregates: small-cell suppression. CMS-grade 11 when true.
PATIENT360_K_MIN=5
PATIENT360_K_MIN_CMS=false
# Session cookie Secure flag. false only for loopback HTTP in the lab.
PATIENT360_COOKIE_SECURE=false
PATIENT360_AGENT_RUNTIME=inproc
PATIENT360_QDRANT_URL=http://qdrant:6333
PATIENT360_EMBED_URL=http://embed:8000

PATIENT360_MINIO_USER=patient360
PATIENT360_MINIO_PASSWORD=change-me-minio
ORTHANC_USERS_JSON={"patient360":"change-me-orthanc"}
