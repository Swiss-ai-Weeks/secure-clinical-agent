# Copy to .env and fill locally. Do not commit .env.

UID=1000
GID=1000

# Required to pull and start NVIDIA NIMs. Export it; do not paste it into chat.
NGC_API_KEY=

# Optional. Needed if google/medgemma-1.5-4b-it is gated on Hugging Face.
HF_TOKEN=

# FHIR-flattened Postgres only (127.0.0.1:5432).
PATIENT360_FHIR_PASSWORD=change-me-fhir

# OpenFGA grants (127.0.0.1:8091).
PATIENT360_OPENFGA_KEY=change-me-openfga

# immudb append-only audit (127.0.0.1:3322).
PATIENT360_AUDIT_PASSWORD=change-me-audit

# Qdrant note-chunk vectors (127.0.0.1:6333).
PATIENT360_QDRANT_API_KEY=change-me-qdrant

# OpenBao linkage vault (127.0.0.1:8200). Dev listener for this lab; not Shamir-sealed.
PATIENT360_LINKAGE_TOKEN=change-me-linkage

PATIENT360_MINIO_USER=patient360
PATIENT360_MINIO_PASSWORD=change-me-minio
ORTHANC_USERS_JSON={"patient360":"change-me-orthanc"}
