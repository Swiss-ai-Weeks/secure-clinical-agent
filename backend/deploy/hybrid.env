# Shell configuration for the legacy RAG launcher (not present in this checkout).
# RAG_ROOT remains the repository root. No secrets belong here.
# NVIDIA RAG v2.6.2 uses the 2.6.0 application containers.
export TAG=2.6.0
export USERID="$(id -u)"
export MODEL_DIRECTORY="$RAG_ROOT/.cache/models"
export DATASET_ROOT="$RAG_ROOT/.data/documents"
export PROMPT_CONFIG_FILE="$RAG_ROOT/.vendor/nvidia-rag/src/nvidia_rag/rag_server/prompt.yaml"

# The only enabled remote AI service: NVIDIA-hosted response generation.
export APP_LLM_MODELNAME=nvidia/nemotron-3-super-120b-a12b
export APP_LLM_SERVERURL=https://integrate.api.nvidia.com/v1
export APP_QUERYREWRITER_MODELNAME="$APP_LLM_MODELNAME"
export APP_QUERYREWRITER_SERVERURL="$APP_LLM_SERVERURL"
export APP_FILTEREXPRESSIONGENERATOR_MODELNAME="$APP_LLM_MODELNAME"
export APP_FILTEREXPRESSIONGENERATOR_SERVERURL="$APP_LLM_SERVERURL"
export REFLECTION_LLM="$APP_LLM_MODELNAME"
export REFLECTION_LLM_SERVERURL="$APP_LLM_SERVERURL"
export SUMMARY_LLM="$APP_LLM_MODELNAME"
export SUMMARY_LLM_SERVERURL="$APP_LLM_SERVERURL"
export LLM_MAX_TOKENS=4096
export LLM_ENABLE_THINKING=false
export LLM_LOW_EFFORT=false
export ENABLE_QUERYREWRITER=False
export ENABLE_FILTER_GENERATOR=False
export ENABLE_REFLECTION=False
export ENABLE_AGENTIC_RAG=False
export ENABLE_GUARDRAILS=False
export ENABLE_VLM_INFERENCE=False
export ENABLE_CITATIONS=True
export ENABLE_RERANKER=True
export APP_TRACING_ENABLED=False
export COLLECTION_NAME=clinical_demo

# Retrieval and indexing use the same local embedding model and dimensions.
export APP_EMBEDDINGS_MODELNAME=nvidia/llama-nemotron-embed-vl-1b-v2
export APP_EMBEDDINGS_SERVERURL=nemotron-vlm-embedding-ms:8000/v1
export APP_EMBEDDINGS_DIMENSIONS=2048
export APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-1b-v2
export APP_RANKING_SERVERURL=nemotron-ranking-ms:8000
export APP_VECTORSTORE_NAME=elasticsearch
export APP_VECTORSTORE_URL=http://elasticsearch:9200
export APP_VECTORSTORE_ENABLEGPUINDEX=False
export APP_VECTORSTORE_ENABLEGPUSEARCH=False
export OBJECTSTORE_ENDPOINT=seaweedfs:9010

# GPU 1: embedding and reranking. GPU 0: document extraction and OCR.
export VLM_EMBEDDING_MS_GPU_ID=1
export RANKING_MS_GPU_ID=1
export YOLOX_MS_GPU_ID=0
export YOLOX_GRAPHICS_MS_GPU_ID=0
export YOLOX_TABLE_MS_GPU_ID=0
export OCR_MS_GPU_ID=0
export OCR_GRPC_ENDPOINT=nemotron-ocr:8001
export OCR_HTTP_ENDPOINT=http://nemotron-ocr:8000/v1/infer
export OCR_INFER_PROTOCOL=grpc
export OCR_MODEL_NAME=pipeline
export YOLOX_GRPC_ENDPOINT=page-elements:8001
export YOLOX_HTTP_ENDPOINT=http://page-elements:8000/v1/infer
export YOLOX_INFER_PROTOCOL=grpc
export YOLOX_GRAPHIC_ELEMENTS_GRPC_ENDPOINT=graphic-elements:8001
export YOLOX_GRAPHIC_ELEMENTS_HTTP_ENDPOINT=http://graphic-elements:8000/v1/infer
export YOLOX_GRAPHIC_ELEMENTS_INFER_PROTOCOL=grpc
export YOLOX_TABLE_STRUCTURE_GRPC_ENDPOINT=table-structure:8001
export YOLOX_TABLE_STRUCTURE_HTTP_ENDPOINT=http://table-structure:8000/v1/infer
export YOLOX_TABLE_STRUCTURE_INFER_PROTOCOL=grpc
export APP_NVINGEST_PAGEELEMENTSURL=http://page-elements:8000/v1/infer
export APP_NVINGEST_GRAPHICELEMENTSURL=http://graphic-elements:8000/v1/infer
export APP_NVINGEST_OCRURL=http://nemotron-ocr:8000/v1/infer
export APP_NVINGEST_TABLESTRUCTUREURL=http://table-structure:8000/v1/infer
export APP_NVINGEST_EXTRACTTEXT=True
export APP_NVINGEST_EXTRACTTABLES=True
export APP_NVINGEST_EXTRACTCHARTS=True
export APP_NVINGEST_EXTRACTIMAGES=False
export APP_NVINGEST_EXTRACTINFOGRAPHICS=False
export APP_NVINGEST_EXTRACTPAGEASIMAGE=False
export MAX_INGEST_PROCESS_WORKERS=4
export NV_INGEST_MAX_UTIL=8
export ENABLE_REDIS_BACKEND=True
