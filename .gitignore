.vendor/
.secrets/
.cache/
# Only ingestion source snapshots are eligible for Git; other data stays local.
/.data/*
!/.data/ingestion/

# Database backups can contain credentials; transient/debug artifacts stay local.
/.data/pg-rebuild-*/
/.data/**/.worker.lock
/.data/**/.attempt-*/
/.data/**/.structured-*/
/.data/**/.evaluation-*/
/.data/**/*-wal
/.data/**/*-shm
/.data/**/*-journal
/.data/**/*.dump
/.data/**/*.sql
/.data/**/postgres-debug.log
.env
__pycache__/

# Local environment variants; keep templates in source control.
.env.*
!.env.example

# Historical local access diagnostics are not part of the published project.
/.scratch/rag-blueprint-reliability/
.venv/
.pytest_cache/
.ruff_cache/